@using Licitaciones.Application.Common
@using Licitaciones.Web.Models.Licitaciones
@model PaginaResultado<LicitacionItemViewModel>

@{
    ViewData["Title"] = "Licitaciones";
    var codigo = ViewData["Codigo"] as string;
    var ordenarPor = (string)(ViewData["OrdenarPor"] ?? "fechaCierre");
    var descendente = (bool)(ViewData["Descendente"] ?? false);
    var totalPaginas = (int)Math.Ceiling(Model.Total / (double)Model.TamanoPagina);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Licitaciones</h1>
    <a asp-action="Create" class="btn btn-primary">Crear licitación</a>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <label for="codigo" class="visually-hidden">Código</label>
        <input id="codigo" name="codigo" value="@codigo" class="form-control" placeholder="Filtrar por código" />
    </div>
    <div class="col-md-3">
        <label for="ordenarPor" class="visually-hidden">Ordenar por</label>
        <select id="ordenarPor" name="ordenarPor" class="form-select">
            <option value="fechaCierre" selected="@(ordenarPor == "fechaCierre")">Fecha de cierre</option>
            <option value="codigo" selected="@(ordenarPor == "codigo")">Código</option>
            <option value="presupuesto" selected="@(ordenarPor == "presupuesto")">Presupuesto</option>
        </select>
    </div>
    <div class="col-md-2 form-check align-self-center">
        <input id="descendente" name="descendente" value="true" type="checkbox" checked="@descendente" class="form-check-input" />
        <label for="descendente" class="form-check-label">Descendente</label>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">Aplicar</button>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr><th>Título</th><th>Presupuesto</th><th>Fecha de cierre</th><th>Estado</th></tr>
    </thead>
    <tbody>
    @foreach (var licitacion in Model.Items)
    {
        <tr>
            <td>@licitacion.Titulo</td>
            <td>@licitacion.Presupuesto.ToString("N2")</td>
            <td>@licitacion.FechaCierre.ToString("g")</td>
            <td>@licitacion.Estado</td>
        </tr>
    }
    </tbody>
</table>

@if (Model.Items.Count == 0)
{
    <p>No se encontraron licitaciones.</p>
}

@if (totalPaginas > 1)
{
    <nav aria-label="Paginación de licitaciones">
        <ul class="pagination">
        @for (var pagina = 1; pagina <= totalPaginas; pagina++)
        {
            <li class="page-item @(pagina == Model.Pagina ? "active" : null)">
                <a class="page-link" asp-action="Index" asp-route-pagina="@pagina"
                   asp-route-tamanoPagina="@Model.TamanoPagina" asp-route-codigo="@codigo"
                   asp-route-ordenarPor="@ordenarPor" asp-route-descendente="@descendente">@pagina</a>
            </li>
        }
        </ul>
    </nav>
}
