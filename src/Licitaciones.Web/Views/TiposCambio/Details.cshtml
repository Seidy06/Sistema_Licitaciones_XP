@model DetalleTipoCambioViewModel

@{
    ViewData["Title"] = "Detalle de tipo de cambio";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Tipo de cambio</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Editar</a>
        @if (!Model.Activo)
        {
            <form asp-action="Activar" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-success">Activar</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</div>

<div class="row">
    <div class="col-12 col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Información del tipo de cambio</h5>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Moneda origen</dt>
                    <dd class="col-sm-8">@Model.MonedaOrigen</dd>
                    <dt class="col-sm-4">Moneda destino</dt>
                    <dd class="col-sm-8">@Model.MonedaDestino</dd>
                    <dt class="col-sm-4">Valor</dt>
                    <dd class="col-sm-8">@Model.Valor.ToString("N4")</dd>
                    <dt class="col-sm-4">Fecha</dt>
                    <dd class="col-sm-8">@Model.Fecha.ToString("yyyy-MM-dd")</dd>
                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">
                        @if (Model.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>
