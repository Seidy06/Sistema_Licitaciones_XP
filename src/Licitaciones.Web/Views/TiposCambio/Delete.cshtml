@model EliminarTipoCambioViewModel

@{
    ViewData["Title"] = "Desactivar tipo de cambio";
}

<h1>Desactivar tipo de cambio</h1>

<div class="alert alert-warning">
    ¿Está seguro que desea desactivar este tipo de cambio?
</div>

<div class="row">
    <div class="col-12 col-md-6">
        <div class="card">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Moneda origen</dt>
                    <dd class="col-sm-8">@Model.MonedaOrigen</dd>
                    <dt class="col-sm-4">Moneda destino</dt>
                    <dd class="col-sm-8">@Model.MonedaDestino</dd>
                    <dt class="col-sm-4">Valor</dt>
                    <dd class="col-sm-8">@Model.Valor.ToString("N4")</dd>
                    <dt class="col-sm-4">Fecha</dt>
                    <dd class="col-sm-8">@Model.Fecha.ToString("yyyy-MM-dd")</dd>
                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">
                        @if (Model.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Confirmar desactivación</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
