@if (TempData["MensajeExito"] is string mensajeExito)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeExito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["MensajeError"] is string mensajeError)
{
    <div class="alert alert-danger" role="alert">@mensajeError</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        <div asp-validation-summary="ModelOnly" class="mb-0"></div>
    </div>
}
