@model Licitaciones.Web.Models.NivelesAprobacion.EliminarNivelAprobacionViewModel

@{
    ViewData["Title"] = "Eliminar nivel de aprobación";
}

<h1>Eliminar nivel de aprobación</h1>

<div class="alert alert-warning" role="alert">
    ¿Confirma que desea eliminar este nivel de aprobación? Quedará desactivado.
</div>

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>
    <dt class="col-sm-3">Monto mínimo</dt>
    <dd class="col-sm-9">@Model.MontoMinimo.ToString("N2")</dd>
    <dt class="col-sm-3">Monto máximo</dt>
    <dd class="col-sm-9">@(Model.MontoMaximo?.ToString("N2") ?? "Sin límite")</dd>
</dl>

<form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Confirmar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
