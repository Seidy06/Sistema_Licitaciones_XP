@model Licitaciones.Web.Models.NivelesAprobacion.EliminarNivelAprobacionViewModel

@{
    ViewData["Title"] = "Eliminar nivel de aprobación";
}

<div class="section-header">
    <h1>Eliminar nivel de aprobación</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</div>

<div class="alert alert-danger" role="alert">
    ¿Confirma que desea eliminar este nivel de aprobación? Quedará desactivado.
</div>

<div class="row">
    <div class="col-12 col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Resumen</h5>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8"><strong>@Model.Nombre</strong></dd>
                    <dt class="col-sm-4">Monto mínimo</dt>
                    <dd class="col-sm-8">@Model.MontoMinimo.ToString("N2")</dd>
                    <dt class="col-sm-4">Monto máximo</dt>
                    <dd class="col-sm-8">@(Model.MontoMaximo?.ToString("N2") ?? "Sin límite")</dd>
                </dl>
            </div>
        </div>

        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" class="mt-3">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Confirmar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
