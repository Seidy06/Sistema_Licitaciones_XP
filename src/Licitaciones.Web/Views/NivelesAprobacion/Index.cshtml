@using Licitaciones.Application.Common
@using Licitaciones.Web.Models.NivelesAprobacion
@model PaginaResultado<NivelesAprobacionItemViewModel>

@{
    ViewData["Title"] = "Niveles de aprobación";
    var nombre = ViewData["Nombre"] as string;
    var ordenarPor = (string)(ViewData["OrdenarPor"] ?? "montoMinimo");
    var descendente = (bool)(ViewData["Descendente"] ?? false);
    var totalPaginas = (int)Math.Ceiling(Model.Total / (double)Model.TamanoPagina);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Niveles de aprobación</h1>
    <a asp-action="Create" class="btn btn-primary">Crear nivel</a>
</div>

<partial name="_Mensajes" />

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <label for="nombre" class="visually-hidden">Nombre</label>
        <input id="nombre" name="nombre" value="@nombre" class="form-control" placeholder="Filtrar por nombre" />
    </div>
    <div class="col-md-3">
        <label for="ordenarPor" class="visually-hidden">Ordenar por</label>
        <select id="ordenarPor" name="ordenarPor" class="form-select">
            <option value="montoMinimo" selected="@(ordenarPor == "montoMinimo")">Monto mínimo</option>
            <option value="nombre" selected="@(ordenarPor == "nombre")">Nombre</option>
        </select>
    </div>
    <div class="col-md-2 form-check align-self-center">
        <input id="descendente" name="descendente" value="true" type="checkbox" checked="@descendente" class="form-check-input" />
        <label for="descendente" class="form-check-label">Descendente</label>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">Aplicar</button>
    </div>
</form>

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead>
        <tr><th>Nombre</th><th>Monto mínimo</th><th>Monto máximo</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var nivel in Model.Items)
    {
        <tr>
            <td>@nivel.Nombre</td>
            <td>@nivel.MontoMinimo.Dinero()</td>
            <td>@(nivel.MontoMaximo.Dinero("Sin límite"))</td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@nivel.Id" class="me-2">Detalle</a>
                <a asp-action="Delete" asp-route-id="@nivel.Id" class="text-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

@if (Model.Items.Count == 0)
{
    <p>No se encontraron niveles de aprobación.</p>
}

@if (totalPaginas > 1)
{
    <nav aria-label="Paginación de niveles de aprobación">
        <ul class="pagination">
        @for (var pagina = 1; pagina <= totalPaginas; pagina++)
        {
            <li class="page-item @(pagina == Model.Pagina ? "active" : null)">
                <a class="page-link" asp-action="Index" asp-route-pagina="@pagina"
                   asp-route-tamanoPagina="@Model.TamanoPagina" asp-route-nombre="@nombre"
                   asp-route-ordenarPor="@ordenarPor" asp-route-descendente="@descendente">@pagina</a>
            </li>
        }
        </ul>
    </nav>
}
