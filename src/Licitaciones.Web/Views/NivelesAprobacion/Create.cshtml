@model Licitaciones.Web.Models.NivelesAprobacion.CrearNivelAprobacionViewModel

@{
    ViewData["Title"] = "Crear nivel de aprobación";
}

<h1>Crear nivel de aprobación</h1>

<partial name="_Mensajes" />

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MontoMinimo" class="form-label"></label>
        <input asp-for="MontoMinimo" type="number" min="0" step="0.01" class="form-control" />
        <span asp-validation-for="MontoMinimo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MontoMaximo" class="form-label"></label>
        <input asp-for="MontoMaximo" type="number" min="0" step="0.01" class="form-control" />
        <span asp-validation-for="MontoMaximo" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Crear</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
