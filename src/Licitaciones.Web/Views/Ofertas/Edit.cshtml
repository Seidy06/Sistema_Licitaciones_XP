@model EditarOfertaViewModel

@{
    ViewData["Title"] = "Editar oferta";
}

<div class="section-header">
    <h1>Editar oferta</h1>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
</div>

<div class="row">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="alert alert-info mb-3">
            <strong>Proveedor:</strong> @Model.ProveedorNombre &mdash;
            <strong>Moneda:</strong> @Model.Moneda
        </div>

        <div class="form-card">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="LicitacionId" />
                <input type="hidden" asp-for="ProveedorNombre" />
                <input type="hidden" asp-for="Moneda" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Monto" class="form-label">Monto</label>
                    <input asp-for="Monto" class="form-control" type="number" step="0.01" placeholder="0.00" />
                    <span asp-validation-for="Monto" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
