@using Licitaciones.Application.Common
@using Licitaciones.Application.Proveedores.Consultar
@using Licitaciones.Web.Models.Proveedores
@model PaginaResultado<ProveedorHistoricoResumenViewModel>

@{
    ViewData["Title"] = "Histórico de proveedores";
    var nombre = ViewData["Nombre"] as string;
    var ordenarPor = (ProveedorOrden)(ViewData["OrdenarPor"] ?? ProveedorOrden.Nombre);
    var descendente = (bool)(ViewData["Descendente"] ?? false);
    var totalPaginas = (int)Math.Ceiling(Model.Total / (double)Model.TamanoPagina);
}

<div class="section-header">
    <h1>Histórico de proveedores</h1>
    <div class="actions">
        <a asp-action="Index" class="btn btn-outline-secondary">Volver a activos</a>
    </div>
</div>

<form asp-action="History" method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <label for="nombre" class="visually-hidden">Nombre</label>
        <input id="nombre" name="nombre" value="@nombre" class="form-control" placeholder="Buscar por nombre..." />
    </div>
    <div class="col-md-3">
        <label for="ordenarPor" class="visually-hidden">Ordenar por</label>
        <select id="ordenarPor" name="ordenarPor" class="form-select">
            <option value="Nombre" selected="@(ordenarPor == ProveedorOrden.Nombre)">Nombre</option>
            <option value="FechaCreacion" selected="@(ordenarPor == ProveedorOrden.FechaCreacion)">Fecha de creación</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-primary w-100">Aplicar</button>
    </div>
</form>

<div class="table-responsive">
<table class="table align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Fecha de baja</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var proveedor in Model.Items)
    {
        <tr>
            <td><strong>@proveedor.Nombre</strong></td>
            <td>@proveedor.DeletedAt.ToString("dd/MM/yyyy HH:mm")</td>
            <td class="text-end">
                <a asp-action="HistoryDetails" asp-route-id="@proveedor.Id">Ver detalle</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

@if (Model.Items.Count == 0)
{
    <div class="empty-state">
        <p>No se encontraron proveedores dados de baja.</p>
    </div>
}

@if (totalPaginas > 1)
{
    <nav aria-label="Paginación del histórico de proveedores">
        <ul class="pagination">
        @for (var pagina = 1; pagina <= totalPaginas; pagina++)
        {
            <li class="page-item @(pagina == Model.Pagina ? "active" : null)">
                <a class="page-link" asp-action="History" asp-route-pagina="@pagina"
                   asp-route-tamanoPagina="@Model.TamanoPagina" asp-route-nombre="@nombre"
                   asp-route-ordenarPor="@ordenarPor" asp-route-descendente="@descendente">@pagina</a>
            </li>
        }
        </ul>
    </nav>
}
