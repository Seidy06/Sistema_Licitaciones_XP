@model Licitaciones.Web.Models.Proveedores.EditarProveedorViewModel

@{
    ViewData["Title"] = "Editar proveedor";
}

<div class="section-header">
    <h1>Editar proveedor</h1>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
</div>

<partial name="_Mensajes" />

<div class="form-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden" />
        <input asp-for="Version" type="hidden" />
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" placeholder="Nombre del proveedor" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
